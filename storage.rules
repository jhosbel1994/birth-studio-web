rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Reglas de Storage — Birth Studio
//
// `galeria/` contiene imágenes públicas de portafolio y `boletas/` conserva
// comprobantes privados por usuario. La escritura queda limitada a las cuentas
// de la allowlist. Debe coincidir con Login.jsx y firestore.rules.
//
// Desplegar con:  firebase deploy --only storage
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'jhosbelevilla@gmail.com',
          'bstudio.designe@gmail.com'
        ];
    }

    match /galeria/{fileName} {
      allow read: if true;
      // Solo imágenes de hasta 10 MB, y solo cuentas autorizadas.
      allow write: if isAllowed()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAllowed();
    }

    // Comprobantes privados de gastos. Cada usuario autorizado solo escribe
    // dentro de su propia carpeta; nunca tienen lectura pública.
    match /boletas/{userId}/{fileName} {
      allow read, delete: if isAllowed() && request.auth.uid == userId;
      allow create, update: if isAllowed()
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Cualquier otra ruta: denegada por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
